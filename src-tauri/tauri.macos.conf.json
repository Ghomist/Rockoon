{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build:ui && pnpm fetch:bmodp"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rockoon",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 },
        "transparent": false,
        "shadow": true,
        "width": 1200,
        "height": 750,
        "minWidth": 1000,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
